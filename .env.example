# SawtOS Environment Configuration

# LiveKit Credentials
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voice AI & Model Providers
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Carrier SIP & Telephony (Twilio / Telnyx)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_SIP_DOMAIN=sawtos.sip.twilio.com
TELEPHONY_WEBHOOK_SECRET=supersecret_webhook_key

# Database & Vector Store
DATABASE_URL=postgresql://sawt_admin:sawt_secret@localhost:5432/sawt_db
PGVECTOR_DIMENSION=1536

# Observability & LLM-as-a-Judge
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Healthcare CRM & Compliance
HIPAA_AUDIT_SALT=secure_random_salt_12345
FHIR_SERVER_URL=http://localhost:8080/fhir
